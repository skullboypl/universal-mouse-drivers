# CapRover → App Configs → Environment Variables
# Persistent Directories: /app/data
# Container HTTP Port: 3000
# Skopiuj do .env.caprover i ustaw hasła (plik .env.caprover jest w .gitignore).

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
DATA_DIR=/app/data
NEXT_PUBLIC_SITE_URL=https://umdrivers.com
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong
ADMIN_SECRET=change-me-long-random-hex

# OpenMouse daily sync - the app dispatches the existing GitHub Actions
# workflow itself (web/instrumentation.ts) instead of relying on a `schedule:`
# cron in the YAML. Fine-grained PAT scoped to this repo only, permission
# "Actions: write". Leave unset to disable the self-scheduling (the workflow
# stays runnable manually from the GitHub UI either way).
GITHUB_ACTIONS_TOKEN=
GITHUB_SYNC_REPO=skullboypl/universal-mouse-drivers
GITHUB_SYNC_REF=main
